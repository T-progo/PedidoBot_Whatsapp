@login_required
def dashboard(request):

    context = {
        "total_empresas": Empresa.objects.count(),
        "total_usuarios": PerfilUsuario.objects.count(),
        "total_licencias": Licencia.objects.count(),
        "total_bots": Bot.objects.count(),
