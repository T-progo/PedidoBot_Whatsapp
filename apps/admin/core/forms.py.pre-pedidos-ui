                }
            ),
        }

        labels = {
            "empresa": "Empresa",
            "nombre": "Nombre",
            "estado": "Estado",
            "fecha_inicio": "Fecha de inicio",
            "fecha_fin": "Fecha de vencimiento",
        }


    def __init__(self, *args, **kwargs):

        super().__init__(*args, **kwargs)

        self.fields["empresa"].queryset = (
            self.fields["empresa"]
            .queryset
            .order_by("nombre")
        )


